# Claves de API para NoAIVerdad Backend

# Configuración del Servidor FastAPI
PORT=8000
HOST=0.0.0.0

# Las credenciales de proveedores se guardan en Realtime Database:
# /config/api_keys (GNEWS_API_KEY, GOOGLE_FACT_CHECK_API_KEY,
# X_API_BEARER_TOKEN, META_AD_LIBRARY_TOKEN or FB_META_ACCESS_TOKEN,
# GROK_API_KEY, BLUESKY_HANDLE, BLUESKY_APP_PASSWORD).

# Credenciales privadas del colector; nunca las incluyas en el frontend ni Git.
# Descarga una clave JSON de cuenta de servicio desde Firebase Console > Configuración > Cuentas de servicio.
GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-service-account.json
FIREBASE_DATABASE_URL=https://noaiverdad-72aba-default-rtdb.firebaseio.com

# El servidor recolecta al iniciar y repite cada 6 horas (21600 segundos).
NEWS_REFRESH_INTERVAL_SECONDS=21600
NEWS_SYNC_CONCURRENCY=3
