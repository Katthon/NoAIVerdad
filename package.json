{
  "name": "noaiverdad-desktop",
  "version": "1.0.0",
  "description": "Plataforma Cívica para Monitoreo Electoral en Ecuador - Aplicación de Escritorio",
  "main": "electron/main.js",
  "author": "NoAIVerdad Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "npx -y serve frontend -p 3000",
    "build:exe": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.noaiverdad.desktop",
    "productName": "NoAIVerdad",
    "copyright": "Copyright © 2026-2027 NoAIVerdad Team",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "frontend/img/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoAIVerdad"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
